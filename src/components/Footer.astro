---
import { site } from "@/site.config";
import { phoneLink, phoneDisplay, whatsappLink } from "@/lib/links";

const a = site.address;
const year = new Date().getFullYear();
const social = Object.entries(site.social).filter(([, url]) => url);
const labels: Record<string, string> = { instagram: "Instagram", facebook: "Facebook", tiktok: "TikTok", youtube: "YouTube" };
---

<footer class="footer">
  <div class="container footer__grid">
    <div>
      <p class="footer__brand">{site.name}</p>
      <slot name="tagline" />
    </div>

    <address class="footer__contact">
      {a.street && (
        <p>
          {a.street}{a.district && `, ${a.district}`}<br />
          {a.city} – {a.state}{a.postalCode && `, ${a.postalCode}`}
        </p>
      )}
      {site.contact.phone && <p><a href={phoneLink()}>{phoneDisplay()}</a></p>}
      {site.contact.whatsapp && <p><a href={whatsappLink()} target="_blank" rel="noopener">WhatsApp</a></p>}
      {site.contact.email && <p><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></p>}
    </address>

    {site.openingHours.length > 0 && (
      <div>
        <p class="footer__title">Horários</p>
        <slot name="hours">
          <ul class="footer__list">{site.openingHours.map((h) => <li>{h}</li>)}</ul>
        </slot>
      </div>
    )}

    {social.length > 0 && (
      <nav aria-label="Redes sociais">
        <ul class="footer__list">
          {social.map(([k, url]) => <li><a href={url} target="_blank" rel="noopener">{labels[k] ?? k}</a></li>)}
        </ul>
      </nav>
    )}
  </div>
  <div class="container footer__bottom">
    <p>© {year} {site.name}</p>
  </div>
</footer>

<style>
  .footer { background: var(--color-surface); padding-block: var(--space-16) var(--space-8); margin-top: var(--space-section); }
  .footer__grid { display: grid; gap: var(--space-8); grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
  .footer__brand { font-family: var(--font-display); font-size: var(--text-lg); font-weight: 700; }
  .footer__title { font-weight: 600; margin-bottom: var(--space-2); }
  .footer__contact { font-style: normal; display: grid; gap: var(--space-2); }
  .footer__list { list-style: none; padding: 0; display: grid; gap: var(--space-2); }
  .footer a { text-underline-offset: 4px; }
  .footer__bottom { margin-top: var(--space-12); padding-top: var(--space-6); border-top: 1px solid var(--color-border); font-size: var(--text-sm); color: var(--color-muted); }
</style>
