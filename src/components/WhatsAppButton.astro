---
import { whatsappLink } from "@/lib/links";
const href = whatsappLink();
---

{href && (
  <a href={href} class="wa" target="_blank" rel="noopener" aria-label="Conversar no WhatsApp" data-track-location="floating">
    <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true" fill="currentColor">
      <path d="M16.004 3C8.82 3 3 8.82 3 16c0 2.29.6 4.53 1.74 6.5L3 29l6.68-1.75A12.96 12.96 0 0 0 16 29c7.18 0 13-5.82 13-13S23.18 3 16.004 3Zm0 23.8c-2.02 0-3.99-.54-5.72-1.57l-.41-.24-3.96 1.04 1.06-3.86-.27-.4A10.78 10.78 0 0 1 5.2 16c0-5.96 4.85-10.8 10.8-10.8 5.96 0 10.8 4.84 10.8 10.8 0 5.95-4.84 10.8-10.8 10.8Zm5.92-8.08c-.32-.16-1.92-.95-2.22-1.06-.3-.11-.51-.16-.73.16-.21.32-.84 1.06-1.03 1.27-.19.22-.38.24-.7.08-.33-.16-1.38-.51-2.62-1.62-.97-.86-1.62-1.93-1.81-2.25-.19-.32-.02-.5.14-.66.15-.14.33-.38.49-.57.16-.19.22-.32.32-.54.11-.21.06-.4-.02-.56-.08-.16-.73-1.76-1-2.41-.26-.63-.53-.55-.73-.56h-.62c-.21 0-.56.08-.86.4-.3.32-1.13 1.1-1.13 2.69 0 1.58 1.16 3.12 1.32 3.33.16.22 2.28 3.48 5.53 4.88.77.33 1.37.53 1.84.68.77.25 1.48.21 2.03.13.62-.09 1.92-.78 2.19-1.54.27-.76.27-1.4.19-1.54-.08-.13-.29-.21-.62-.37Z"/>
    </svg>
  </a>
)}

<style>
  .wa {
    position: fixed; right: var(--space-4); bottom: var(--space-4); z-index: 40;
    width: 56px; height: 56px; border-radius: 50%;
    display: grid; place-items: center;
    background: var(--color-whatsapp); color: #fff;
    box-shadow: 0 6px 20px color-mix(in srgb, var(--color-whatsapp) 40%, transparent);
    transition: transform var(--dur) var(--ease-out);
    animation: wa-in var(--dur-slow) var(--ease-out) 1.2s both;
  }
  .wa:hover { transform: scale(1.08); }
  @keyframes wa-in { from { transform: scale(0); } to { transform: scale(1); } }
</style>
