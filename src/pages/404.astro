---
import Base from "@/layouts/Base.astro";
import Button from "@/components/Button.astro";
---

<Base title="Página não encontrada" noindex>
  <section class="container-narrow nf">
    <h1>Página não encontrada</h1>
    <p>O endereço pode ter mudado. Volte para o início ou fale com a gente.</p>
    <Button href="/">Voltar para o início</Button>
  </section>
</Base>

<style>
  .nf { min-height: 60dvh; display: grid; align-content: center; justify-items: start; gap: var(--space-6); padding-block: var(--space-16); }
</style>
